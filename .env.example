# ---- application ----
APP_ENV=development
APP_ADDR=:8080
LOG_LEVEL=info

# memory = zero dependencies, redis = durable and multi-instance
BOOKING_STORE=memory
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# how long a seat stays held before returning to the pool
HOLD_TTL=2m

# enables the Admin dialog and POST /api/v1/admin/movies
# leave empty to disable; must be at least 8 characters when set
ADMIN_TOKEN=admin-demo-token

# comma-separated origins, or * for local development
CORS_ALLOWED_ORIGINS=*

# ---- docker compose ----
APP_PORT=8080
REDIS_PORT=6380
REDIS_COMMANDER_PORT=8081
VERSION=dev
